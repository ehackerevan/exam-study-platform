{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyPack",
  "description": "Study Pack Compiler 正規化學習包資料契約",
  "type": "object",
  "required": ["version", "id", "title", "chapters", "questions"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Study Pack 規範主版本",
      "minimum": 1
    },
    "schemaVersion": {
      "type": "integer",
      "description": "Schema 結構版本",
      "default": 1
    },
    "contentVersion": {
      "type": "string",
      "description": "教材內容版本 (例如 2026.10.1)",
      "default": "1.0.0"
    },
    "id": {
      "type": "string",
      "description": "學習包唯一識別代碼",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "description": "學習包標題",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "學習包說明描述",
      "default": ""
    },
    "language": {
      "type": "string",
      "description": "學習包語系代碼，例如 zh-TW, en-US",
      "default": "zh-TW"
    },
    "author": {
      "type": "string",
      "description": "編寫者或發布單位",
      "default": ""
    },
    "chapters": {
      "type": "array",
      "description": "章節清單",
      "items": {
        "$ref": "#/definitions/Chapter"
      }
    },
    "questions": {
      "type": "array",
      "description": "題庫題目清單",
      "items": {
        "$ref": "#/definitions/Question"
      }
    }
  },
  "definitions": {
    "Chapter": {
      "type": "object",
      "required": ["id", "title", "sections"],
      "properties": {
        "id": {
          "type": "string",
          "description": "章節唯一代號"
        },
        "title": {
          "type": "string",
          "description": "章節名稱"
        },
        "summary": {
          "type": "string",
          "description": "章節摘要",
          "default": ""
        },
        "sections": {
          "type": "array",
          "description": "章節所含小節清單",
          "items": {
            "$ref": "#/definitions/Section"
          }
        }
      }
    },
    "Section": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "description": "小節唯一代號"
        },
        "title": {
          "type": "string",
          "description": "小節名稱"
        },
        "content": {
          "type": "string",
          "description": "小節教材內文 (純文字或簡易 HTML/Markdown)",
          "default": ""
        },
        "keyPoints": {
          "type": "array",
          "description": "重點精華條列清單",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "notes": {
          "type": "array",
          "description": "補充備忘條列清單",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "Question": {
      "type": "object",
      "required": ["id", "chapterId", "type", "question", "options", "answer"],
      "properties": {
        "id": {
          "type": "string",
          "description": "題目唯一識別代碼"
        },
        "chapterId": {
          "type": "string",
          "description": "所屬章節代碼"
        },
        "sectionId": {
          "type": "string",
          "description": "所屬小節代碼 (選填)",
          "default": ""
        },
        "type": {
          "type": "string",
          "enum": ["single-choice", "true-false", "multiple-choice"],
          "description": "題型"
        },
        "question": {
          "type": "string",
          "description": "題目敘述內文",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "description": "選項文字清單",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "answer": {
          "description": "正確答案 (0-based 數字索引或數字索引陣列)",
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "minItems": 1
            }
          ]
        },
        "explanation": {
          "type": "string",
          "description": "題目詳解解析",
          "default": ""
        },
        "sourceExam": {
          "type": "object",
          "required": ["term", "subject", "number"],
          "properties": {
            "term": { "type": "string", "minLength": 1 },
            "subject": { "type": "string", "minLength": 1 },
            "number": { "type": "integer", "minimum": 1 }
          }
        },
        "featuredGroup": {
          "type": "string",
          "description": "精選題組代碼"
        },
        "featuredRank": {
          "type": "integer",
          "minimum": 1,
          "description": "精選題組中的排序"
        }
      }
    }
  }
}
